{
  "name": "@better-answers/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation": "stryker run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@better-answers/core": "workspace:*",
    "@better-answers/schema": "workspace:*",
    "@hono/node-server": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
