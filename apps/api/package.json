{
  "name": "@better-answers/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc/app-router.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "ops": "node src/ops.ts",
    "serve:e2e": "node tests/serve.ts",
    "serve:local": "node tests/local.ts",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation": "stryker run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@better-answers/core": "workspace:*",
    "@better-answers/schema": "workspace:*",
    "@better-auth/cimd": "1.7.2",
    "@better-auth/core": "1.7.2",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@hono/node-server": "2.1.1",
    "@hono/trpc-server": "0.4.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@trpc/server": "11.18.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "jose": "6.2.12",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
