{
  "name": "@better-answers/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc/app-router.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/migrate.ts",
    "ops": "node src/ops.ts",
    "serve:e2e": "node tests/serve.ts",
    "serve:local": "node tests/local.ts",
    "lint": "oxlint --report-unused-disable-directives-severity=error --config ../../.oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "images": "pnpm run test --config vitest.images.config.ts",
    "mutation": "node ./node_modules/@stryker-mutator/core/bin/stryker.js run",
    "check": "node ../../scripts/check.mjs typecheck test"
  },
  "dependencies": {
    "@better-answers/core": "workspace:*",
    "@better-answers/design-system": "workspace:*",
    "@better-answers/schema": "workspace:*",
    "@better-auth/cimd": "1.7.11",
    "@better-auth/core": "1.7.11",
    "@better-auth/drizzle-adapter": "1.7.11",
    "@better-auth/oauth-provider": "1.7.11",
    "@better-auth/passkey": "1.7.11",
    "@better-auth/utils": "0.5.0",
    "@hono/node-server": "2.1.5",
    "@hono/trpc-server": "0.4.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@simplewebauthn/server": "13.3.3",
    "@trpc/server": "11.19.0",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-answers/devtools": "workspace:*",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@trpc/client": "11.19.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
