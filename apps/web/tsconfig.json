{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Vite resolves this workspace, so TypeScript resolves it Vite's way: `module: preserve`
    // with `moduleResolution: bundler` is the pairing TypeScript's 6.0 notes prescribe for
    // bundled web applications (with `nodenext` reserved for code Node runs, which is the
    // base config's case and never this workspace's), and it is what `create-vite`'s React
    // template ships. `preserve` keeps `verbatimModuleSyntax` and the explicit `.ts`
    // extensions this repository writes; nothing here is emitted. The setting stands on
    // that guidance alone (T-037).
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    // `@/` is what makes the layering rules legible to a linter: an import that crosses a
    // directory is written `@/<zone>/…`, so the per-glob `no-restricted-imports` overrides in
    // `.oxlintrc.json` can name a zone instead of guessing how many `../` a file climbed.
    // TypeScript 7 removed `baseUrl`; the mapping is relative to this file instead.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
