# The api image builds from the repository root, so this file decides what a `COPY` or a
# build step can read. `apps/worker/` has its own `.dockerignore`, because the worker image
# builds from that directory.

# Secrets and local state
.env
.env.*
.git
.gitignore
.claude
.cubic
.scratch

# Build products from the host. The image builds its own.
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.vite
**/coverage
**/test-results
**/playwright-report
**/blob-report
**/reports
**/.stryker-tmp
*.log

# Not needed at runtime or as build input
.github
apps/worker
contracts
deploy
docs
cubic.yaml
renovate.json
