{
  "mcpServers": {
    "jcodemunch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["jcodemunch-mcp"]
    },
    "jdocmunch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["jdocmunch-mcp"]
    },
    "gitnexus": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "command -v gitnexus >/dev/null && exec gitnexus mcp || exec npx -y gitnexus@latest mcp"
      ]
    },
    "kibo-ui": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://www.kibo-ui.com/api/mcp/mcp"]
    }
  }
}
