# Local development. Every real secret lives in Coolify's environment or the password
# manager (apps/docs-site/operations/SECRETS.md); nothing here is a credential that reaches an estate.
#
#   cp .env.example .env
#
# The bootstrap class, and the only variables either tier reads directly
# (apps/api/src/config.ts, apps/worker/src/better_answers_worker/config.py). Every other credential
# class is a row under the envelope and never an environment variable.

DATABASE_URL=postgresql://better_answers:better_answers@127.0.0.1:5432/better_answers
PORT=3000

# Where apps/web's static build is; the app serves it on `app.` (ADR 0006, amended
# 2026-09-02). Defaults to this repository's own apps/web/dist, which is what
# `pnpm --filter @better-answers/web build` writes; an image that lays it down elsewhere
# names it.
# WEB_ROOT=/srv/web
