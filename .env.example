# Local development. Every real secret lives in Coolify's environment or the password
# manager (docs/operations/SECRETS.md); nothing here is a credential that reaches an estate.
#
#   cp .env.example .env
#
# The deployment's own secrets, and the only variables either tier reads directly
# (apps/api/src/config.ts, apps/worker/src/better_answers_worker/config.py). A workspace's or a
# person's secret is a row in the database and never an environment variable (ADR 0052).

DATABASE_URL=postgresql://better_answers:better_answers@127.0.0.1:55432/better_answers
PORT=3000

# Where apps/web's static build is; the api serves it on `app.` (ADR 0006, amended
# 2026-09-02). Defaults to this repository's own apps/web/dist, which is what
# `pnpm --filter @better-answers/web build` writes; an image that lays it down elsewhere
# names it.
# WEB_ROOT=/srv/web
