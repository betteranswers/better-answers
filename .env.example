# Local development. Every real secret lives in Coolify's environment or the password
# manager (deploy/SECRETS.md); nothing here is a credential that reaches an estate.
#
#   cp .env.example .env
#
# The bootstrap class, and the only variables either tier reads directly
# (app/src/config.ts, worker/src/better_answers_worker/config.py). Every other credential
# class is a row under the envelope and never an environment variable (`[SEC1]`).

DATABASE_URL=postgresql://better_answers:better_answers@127.0.0.1:5432/better_answers
PORT=3000
