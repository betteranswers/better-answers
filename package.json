{
  "name": "better-answers",
  "private": true,
  "description": "Better Answers — a living company knowledge map for UK SMBs on OKF v0.2 (see AGENTS.md)",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || echo 'lefthook is absent — no git hooks installed (see lefthook.yml)'",
    "check": "node scripts/check.mjs check:gates check:workspaces check:worker",
    "check:gates": "node scripts/check.mjs format:check lint lint:workflows comment-gate:python comment-density insert-scan loose-files test-folders table-ownership-scan auth-seam-scan port-scan climb-scan jscpd knip",
    "check:workspaces": "pnpm -r --no-bail --if-present run check",
    "check:tree": "node scripts/check.mjs check:gates check:libraries",
    "check:libraries": "pnpm --no-bail --if-present --filter @better-answers/core --filter @better-answers/schema --filter @better-answers/devtools run check",
    "check:root": "node scripts/check.mjs check:gates check:libraries:unsharded check:core:typecheck",
    "check:libraries:unsharded": "pnpm --no-bail --if-present --filter @better-answers/schema --filter @better-answers/devtools run check",
    "check:core:typecheck": "pnpm --filter @better-answers/core run typecheck",
    "check:core:suite": "pnpm --filter @better-answers/core run test",
    "check:api": "pnpm --no-bail --if-present --filter @better-answers/api run check",
    "check:web": "pnpm --no-bail --if-present --filter @better-answers/web run check",
    "check:web:unit": "node scripts/check.mjs check:web:typecheck check:web:test",
    "check:web:typecheck": "pnpm --filter @better-answers/web run typecheck",
    "check:web:test": "pnpm --filter @better-answers/web run test",
    "check:web:e2e": "pnpm --filter @better-answers/web run e2e",
    "check:worker": "cd apps/worker && uv run --frozen check",
    "check:images": "node scripts/check.mjs check:images:api check:images:worker",
    "check:images:api": "pnpm --filter @better-answers/api run images",
    "check:images:worker": "cd apps/worker && uv run --frozen images",
    "check:docs": "node scripts/check.mjs format:check check:docs:core check:docs:devtools check:docs:web",
    "check:docs:core": "pnpm --filter @better-answers/core run test test/tier-contract.test.ts",
    "check:docs:devtools": "pnpm --filter @better-answers/devtools run test test/ci/deploy-tree.test.ts test/ci/docs-lane.test.ts test/ci/tracked-skills.test.ts test/scans/contract-paths.test.ts test/gates/solutions-docs.test.ts",
    "check:docs:web": "pnpm --filter @better-answers/web run test test/gates/web-skills.test.ts",
    "jscpd": "node scripts/jscpd.mjs",
    "comment-gate:python": "python3 packages/devtools/python/comment_gate.py apps packages .github deploy .claude/hooks scripts cubic.yaml lefthook.yml pnpm-workspace.yaml",
    "comment-density": "node scripts/comment-density.mjs apps packages",
    "insert-scan": "node scripts/insert-scan.mjs apps packages",
    "loose-files": "node scripts/loose-files.mjs",
    "test-folders": "node scripts/test-folders.mjs",
    "move-files": "node scripts/move-files.mjs",
    "table-ownership-scan": "node scripts/table-ownership-scan.mjs packages/core/src apps/api/src",
    "auth-seam-scan": "node scripts/auth-seam-scan.mjs apps/web/tsconfig.json apps/web/src/features/auth/auth-hooks.ts",
    "port-scan": "python3 packages/devtools/python/port_scan.py apps/worker/src",
    "climb-scan": "python3 packages/devtools/python/climb_scan.py apps/worker/tests packages/devtools/python",
    "mutant-probe": "node scripts/mutant-probe.mjs",
    "reap-containers": "node scripts/reap-containers.mjs",
    "comment-inventory": "node scripts/comment-inventory.mjs",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:workflows": "node scripts/check.mjs lint:workflows:actionlint lint:workflows:zizmor lint:workflows:shellcheck",
    "lint:workflows:actionlint": "uv run --project apps/worker --frozen --only-group dev actionlint -config-file .github/actionlint.yaml",
    "lint:workflows:zizmor": "uv run --project apps/worker --frozen --only-group dev zizmor --offline --config .github/zizmor.yml .github",
    "lint:workflows:shellcheck": "uv run --project apps/worker --frozen --only-group dev find deploy .claude/hooks scripts -name '*.sh' -exec shellcheck --external-sources --source-path=SCRIPTDIR {} +",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "migrate": "pnpm --filter @better-answers/api run migrate",
    "ops": "pnpm --filter @better-answers/api run ops --",
    "mutation": "pnpm -r --if-present run mutation"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "jscpd": "5.4.2",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-eslint": "1.90.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.16.1"
}
