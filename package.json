{
  "name": "better-answers",
  "private": true,
  "description": "Better Answers — a living company knowledge map for UK SMBs on OKF v0.2 (see AGENTS.md)",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || echo 'lefthook is absent — no git hooks installed (see lefthook.yml)'",
    "check": "node scripts/check.mjs format:check lint comment-gate:ts comment-gate:python comment-density insert-scan jscpd knip check:workspaces check:worker",
    "check:workspaces": "pnpm -r --no-bail --if-present run check",
    "check:worker": "cd apps/worker && uv run --frozen check",
    "check:docs": "node scripts/check.mjs format:check check:docs:api check:docs:core check:docs:web",
    "check:docs:api": "pnpm --filter @better-answers/api exec vitest run tests/adr-index.test.ts tests/coding-rules-form.test.ts tests/coding-rules-tags.test.ts tests/deploy-tree.test.ts tests/docs-lane.test.ts tests/provision-skills.test.ts",
    "check:docs:core": "pnpm --filter @better-answers/core exec vitest run test/tier-contract.test.ts",
    "check:docs:web": "pnpm --filter @better-answers/web exec vitest run test/browser-suite-skill.test.ts",
    "land": "node scripts/land.mjs",
    "jscpd": "node scripts/jscpd.mjs",
    "comment-gate:ts": "oxlint --config packages/devtools/lint-rules/comment-gate.oxlintrc.json apps packages",
    "comment-gate:python": "python3 packages/devtools/python/comment_gate.py apps packages",
    "comment-density": "node scripts/comment-density.mjs apps packages",
    "insert-scan": "node scripts/insert-scan.mjs apps packages",
    "mutant-probe": "node scripts/mutant-probe.mjs",
    "strip-comments": "node scripts/strip-comments.mjs",
    "comment-only-proof": "node scripts/comment-only-proof.mjs",
    "lint": "oxlint",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "migrate": "pnpm --filter @better-answers/api run migrate",
    "ops": "pnpm --filter @better-answers/api run ops --",
    "mutation": "pnpm -r --if-present run mutation"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "jscpd": "5.1.2",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0"
}
