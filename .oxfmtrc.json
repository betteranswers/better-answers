{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "internalPattern": ["@better-answers/"],
    "customGroups": [{ "groupName": "app-alias", "elementNamePattern": ["@/**"] }],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      "app-alias",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "deploy/**",
    "renovate.json",
    "packages/devtools/lifts/anti-slop/**",
    ".claude/worktrees/**",
    "packages/schema/migrations/**",
    "packages/schema/roles-surface.json",
    ".cache/**"
  ]
}
