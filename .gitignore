# dependencies and builds
node_modules/
dist/
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.turbo/
coverage/
# `reports/mutation/` carries a slash, so git anchored it to the repository root and left
# `apps/api/reports/` and `apps/web/reports/` tracked. Every workspace writes its mutation report
# under its own `reports/` (`[TEST6]`), so the pattern has to match at any depth.
reports/

# Mutation testing leftovers ([TEST6]): mutmut copies the tier into `apps/worker/mutants/`, and
# Stryker's Vitest runner writes a per-worker setup file into the workspace it runs in.
mutants/
stryker-setup-*.js

# local env — every secret lives in Coolify's env or the password manager (deploy/SECRETS.md)
.env
.env.*
!.env.example

# worker state is never committed and never backed up (ADR 0005 amendment)
/data/

# tooling
.DS_Store
.memdb/
.lavish/*.session

# wizard facts file (URLs, names, UUIDs — no secrets, but local)
deploy/wizard-41.env

# client material and the local planning map — never in the repository
.planning/
.scratch/
.lavish/
15-user-feedback.md
old-suggested-schema.md
AGENTS.md.bak

# agent tooling installed from third parties — never ours to publish ([LIFT3], ADR 0027).
# Skills are reinstalled from their sources; `tasks/AGENTS.md` from `ordna skill install`.
.claude/skills/
.agents/
skills-lock.json
tasks/AGENTS.md

# Worktrees created by background agents (Claude Code `isolation: worktree`).
.claude/worktrees/

# A person's own Claude Code overrides (permissions, skill toggles); the project's hooks live in .claude/settings.json.
.claude/settings.local.json
