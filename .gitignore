# dependencies and builds
node_modules/
dist/
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.turbo/
coverage/
# `reports/mutation/` carries a slash, so git anchored it to the repository root and left
# `apps/api/reports/` and `packages/core/reports/` tracked. Every workspace on the mutation
# schedule writes its report and its incremental result file under its own `reports/`, so the
# pattern has to match at any depth — and the incremental file is git-ignored on purpose:
# actions/cache is what carries it from night to night.
reports/

# Mutation testing leftovers: mutmut copies the tier into `apps/worker/mutants/`, and
# Stryker's Vitest runner writes a per-worker setup file into the workspace it runs in.
mutants/
stryker-setup-*.js

# Playwright's per-run artefacts (traces, screenshots) and its last-run marker.
test-results/
playwright-report/

# local env — every secret lives in Coolify's env or the password manager (apps/docs-site/operations/SECRETS.md)
.env
.env.*
!.env.example

# worker state is never committed and never backed up (ADR 0005 amendment)
/data/

# tooling
.DS_Store
.memdb/
.lavish/*.session

# wizard facts file (URLs, names, UUIDs — no secrets, but local)
deploy/wizard-41.env

# client material and the local planning map — never in the repository
.planning/
.scratch/
.lavish/
15-user-feedback.md
old-suggested-schema.md
AGENTS.md.bak

# agent tooling installed from third parties — never ours to publish (ADR 0027).
# A worktree gets these copied from the primary checkout by .claude/hooks/provision-skills.sh;
# a fresh clone reinstalls them from `skills-lock.json`, and `tasks/AGENTS.md` from
# `ordna skill install`. The lock itself is tracked: it is this repository's manifest of
# what it installs, not the third parties' content, so ADR 0027 does not reach it.
# Wildcarded rather than the directory, because git will not descend into an excluded
# directory to re-include anything inside it — and the two entries below are ours, written in
# this repository and tracked with it, so a fresh clone or worktree has them with no install
# step. The design skill is a relative symlink and not a copy: it belongs beside the
# guidelines, tokens and assets its own text sends a reader to, which are a package
# (`packages/design-system/`), and a copy here would be a second tracked original of a file
# that already has one — two to edit and one to forget. A link is also what
# `.claude/hooks/provision-skills.sh` can carry into a worktree, which it checks by resolving
# every link under this directory and refusing any that lands outside the tree.
.claude/skills/*
!.claude/skills/browser-suite/
!.claude/skills/better-answers-design
.agents/
tasks/AGENTS.md

# Worktrees created by background agents (Claude Code `isolation: worktree`).
.claude/worktrees/

# A person's own Claude Code overrides (permissions, skill toggles); the project's hooks live in .claude/settings.json.
.claude/settings.local.json
