{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "import",
    "node",
    "promise"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./packages/devtools/lifts/anti-slop/index.ts"
    },
    {
      "name": "better-answers",
      "specifier": "./packages/devtools/lint-rules/index.ts"
    },
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "unicorn/prefer-set-has": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-deprecated": "error",
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "promise/no-callback-in-promise": "error",
    "promise/no-multiple-resolved": "error",
    "typescript/only-throw-error": [
      "error",
      { "allow": [{ "from": "package", "package": "@tanstack/router-core", "name": "Redirect" }] }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-constructed-context-values": "error",
    "complexity": ["error", { "max": 8 }],
    "node/no-process-env": "error",
    "import/no-cycle": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-param-reassign": ["error", { "props": true }],
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "BinaryExpression[operator='in'][right.type='Identifier'][right.name=/^[A-Z][A-Z0-9_]+$/]",
        "message": "`in` also finds keys that the table inherits, such as `toString`. Test the key with `Object.hasOwn(TABLE, key)`, or store the table in a `Map`."
      },
      {
        "selector": "ForInStatement",
        "message": "`for…in` also visits the keys that an object inherits. Loop over `Object.keys` or `Object.entries` with `for…of` instead."
      },
      {
        "selector": "LabeledStatement",
        "message": "Labelled statements are not allowed. Move the inner loop into a function and return from it, instead of using a label to jump out of the nested loop."
      },
      {
        "selector": "CallExpression[callee.object.name='z'][callee.property.name='enum'] > :matches(ArrayExpression, TSAsExpression[expression.type='ArrayExpression'], TSSatisfiesExpression[expression.type='ArrayExpression'])",
        "message": "Do not write the values inside `z.enum`, because the list is a copy of a fixed set and the copy drifts from the original. Declare the set once as an `as const` tuple, derive its type from the tuple, and pass the tuple to `z.enum`."
      },
      {
        "selector": "Literal[regex.flags=/[uv]/][regex.pattern=/^(?:[^\\\\]|\\\\.)*\\\\v/]",
        "message": "This regular expression contains `\\v` and has the `u` or `v` flag. Stryker mutates `\\v` to `\\V`, which those flags reject when the module loads, so the mutation run cannot import this module. Remove the flag, and disable `eslint/require-unicode-regexp` on this line with that reason."
      }
    ],
    "vitest/no-identical-title": "error",
    "vitest/no-conditional-in-test": "error",
    "vitest/valid-title": [
      "error",
      {
        "mustNotMatch": [
          "/(?i:\\bshould\\b)|(?:\\S+\\s+){10}\\S/",
          "A test title is a present-tense phrase of 10 words at most, never \"should\""
        ]
      }
    ],
    "typescript/no-floating-promises": ["error", { "ignoreVoid": true }],
    "typescript/no-unnecessary-condition": "error",
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": false }],
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "eslint/require-unicode-regexp": "error",
    "eslint/no-shadow": "error",
    "eslint/no-await-in-loop": "error",
    "eslint/no-warning-comments": ["error", { "decoration": ["*"] }],
    "unicorn/no-abusive-eslint-disable": "error",
    "oxc/no-async-await": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "better-answers/action-admits-before-await": "error",
    "better-answers/comment-only-the-why": "error",
    "better-answers/declaration-doc-block": "error",
    "better-answers/import-statically": "error",
    "better-answers/string-cites-nothing": "error",
    "better-answers/no-path-climb": "error",
    "better-answers/mcp-entry-annotations": "error",
    "better-answers/mcp-entry-no-workspace-argument": "error",
    "better-answers/import-direction": "error",
    "better-answers/parameter-never-mutated": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "max-lines": ["error", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 150, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "Only files under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/ may import better-auth. Elsewhere in the api, get Claims and a Principal from apps/api/src/auth/ instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/boundary-schemas/drizzle-zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/auth/**", "apps/api/lifts/better-auth-cimd-node/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "jsPlugins": [
        {
          "name": "react-doctor",
          "specifier": "oxlint-plugin-react-doctor"
        }
      ],
      "rules": {
        "react-doctor/rules-of-hooks": "error",
        "react-doctor/no-unguarded-browser-global-in-render-or-hook-init": "error",
        "react-doctor/effect-needs-cleanup": "error",
        "react-doctor/no-effect-with-fresh-deps": "error",
        "react-doctor/aria-role": "error",
        "react-doctor/no-ref-current-in-render": "error",
        "react-doctor/no-impure-state-updater": "error",
        "react-doctor/no-layout-property-animation": "error"
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "kebabCase" }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web must stay inside its own directory. To import from another directory, write the path as `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web must not import from apps/api, so that the two apps share no runtime code. The only exception is an `import type` of `AppRouter` in `apps/web/src/shared/api/trpc.ts`, and no other file may have one."
              },
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "In apps/web, only features/auth/auth-client.ts and features/auth/auth-hooks.ts may import better-auth. Other files use the platform's own types, which those hooks return."
              },
              {
                "group": ["**/auth-client", "**/auth-client.ts"],
                "message": "Only features/auth/auth-hooks.ts may import authClient, because it converts what authClient returns into the platform's own types. Use the hooks in features/auth/auth-hooks.ts instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "A feature must not import another feature. Inside a feature, use relative imports. Move code that two features share into `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "Imports go from `app/` to features to `shared/`, never back. `app/` imports the features, so a feature that imports from `app/` can create an import cycle. Move the code the feature needs into the feature or into `shared/`."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web must stay inside its own directory. To import from another directory, write the path as `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web must not import from apps/api, so that the two apps share no runtime code. The only exception is an `import type` of `AppRouter` in `apps/web/src/shared/api/trpc.ts`, and no other file may have one."
              },
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "In apps/web, only features/auth/auth-client.ts and features/auth/auth-hooks.ts may import better-auth. Other files use the platform's own types, which those hooks return."
              },
              {
                "group": ["**/auth-client", "**/auth-client.ts"],
                "message": "Only features/auth/auth-hooks.ts may import authClient, because it converts what authClient returns into the platform's own types. Use the hooks in features/auth/auth-hooks.ts instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "Code in `shared/` must not import from features or from `app/`, because they all import `shared/` and an upward import makes `shared/` depend on them. Move the code you need into `shared/`, or move this file out of `shared/`."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web must stay inside its own directory. To import from another directory, write the path as `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web must not import from apps/api, so that the two apps share no runtime code. The only exception is an `import type` of `AppRouter` in `apps/web/src/shared/api/trpc.ts`, and no other file may have one."
              },
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "In apps/web, only features/auth/auth-client.ts and features/auth/auth-hooks.ts may import better-auth. Other files use the platform's own types, which those hooks return."
              },
              {
                "group": ["**/auth-client", "**/auth-client.ts"],
                "message": "Only features/auth/auth-hooks.ts may import authClient, because it converts what authClient returns into the platform's own types. Use the hooks in features/auth/auth-hooks.ts instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/api/trpc.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "allowTypeImports": true,
                "message": "This file may import types from apps/api but not values, so that apps/web shares no runtime code with apps/api. Use `import type`."
              },
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "Code in `shared/` must not import from features or from `app/`, because they all import `shared/` and an upward import makes `shared/` depend on them. Move the code you need into `shared/`, or move this file out of `shared/`."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web must stay inside its own directory. To import from another directory, write the path as `@/<zone>/…`."
              },
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "In apps/web, only features/auth/auth-client.ts and features/auth/auth-hooks.ts may import better-auth. Other files use the platform's own types, which those hooks return."
              },
              {
                "group": ["**/auth-client", "**/auth-client.ts"],
                "message": "Only features/auth/auth-hooks.ts may import authClient, because it converts what authClient returns into the platform's own types. Use the hooks in features/auth/auth-hooks.ts instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/features/auth/auth-client.ts",
        "apps/web/src/features/auth/auth-hooks.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "A feature must not import another feature. Inside a feature, use relative imports. Move code that two features share into `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "Imports go from `app/` to features to `shared/`, never back. `app/` imports the features, so a feature that imports from `app/` can create an import cycle. Move the code the feature needs into the feature or into `shared/`."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web must stay inside its own directory. To import from another directory, write the path as `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web must not import from apps/api, so that the two apps share no runtime code. The only exception is an `import type` of `AppRouter` in `apps/web/src/shared/api/trpc.ts`, and no other file may have one."
              },
              {
                "group": ["drizzle-zod"],
                "message": "Only packages/schema/src/boundary-schemas/drizzle-zod.ts may import drizzle-zod. Import the boundary schemas from @better-answers/schema instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/ui/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "react-doctor/effect-needs-cleanup": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/tests/**", "**/e2e/**"],
      "rules": {
        "typescript/require-array-sort-compare": "off",
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-conditional-empty-object-spread": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-type-aliases": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-widen-then-assert": "off",
        "eslint/no-await-in-loop": "off",
        "eslint/require-unicode-regexp": "off",
        "max-lines": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["apps/api/src/config.ts", "apps/web/playwright.config.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["packages/core/src/store/git/door.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["scripts/**", "packages/devtools/src/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["scripts/**", "docs/plans/**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/tests/**", "**/e2e/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test/**",
        "**/tests/**",
        "**/e2e/**",
        "scripts/**"
      ],
      "rules": {
        "better-answers/import-statically": "off"
      }
    },
    {
      "files": ["apps/*/src/**", "packages/*/src/**"],
      "rules": {
        "better-answers/no-path-climb": "off"
      }
    },
    {
      "files": ["apps/api/src/auth/auth.ts"],
      "rules": {
        "max-lines": ["error", { "max": 522, "skipBlankLines": true, "skipComments": true }],
        "max-lines-per-function": [
          "error",
          { "max": 364, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["apps/api/src/auth/second-factor/confirm.ts"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 245, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["apps/api/src/auth/routes.ts"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 153, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/people/groups/groups-page.tsx"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 197, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/sources/connect-action.tsx"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 155, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/knowledge/**", "apps/web/src/shared/knowledge/**"],
      "rules": {
        "better-answers/ui-copy-plain": "error"
      }
    },
    {
      "files": ["packages/schema/scripts/roles-surface.ts"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 200, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["packages/schema/src/table-ownership.ts"],
      "rules": {
        "max-lines": ["error", { "max": 645, "skipBlankLines": true, "skipComments": true }]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "reports",
    ".venv",
    ".wrangler",
    "packages/devtools/lifts/anti-slop/**",
    ".claude/worktrees/**",
    ".claude/skills/**",
    "**/stryker-setup-*.js"
  ]
}
