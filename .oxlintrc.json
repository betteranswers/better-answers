{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "import", "node"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./packages/devtools/lifts/anti-slop/index.ts"
    },
    {
      "name": "better-answers",
      "specifier": "./packages/devtools/lint-rules/index.ts"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    "complexity": ["error", { "max": 8 }],
    "node/no-process-env": "error",
    "import/no-cycle": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "vitest/no-identical-title": "error",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": true }],
    "typescript/no-unnecessary-condition": "error",
    "typescript/require-array-sort-compare": "off",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "eslint/no-warning-comments": ["error", { "decoration": ["*"] }],
    "unicorn/no-abusive-eslint-disable": "error",
    "oxc/no-async-await": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "better-answers/act-admits-before-await": "error",
    "better-answers/comment-only-the-why": "error",
    "better-answers/string-cites-nothing": "error",
    "better-answers/mcp-entry-annotations": "error",
    "better-answers/mcp-entry-no-workspace-argument": "error",
    "better-answers/import-direction": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/; the rest of the tier takes Claims and a Principal from that module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/drizzle-zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/auth/**", "apps/api/lifts/better-auth-cimd-node/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "jsPlugins": [
        {
          "name": "react-doctor",
          "specifier": "oxlint-plugin-react-doctor"
        }
      ],
      "rules": {
        "react-doctor/rules-of-hooks": "error",
        "react-doctor/no-unguarded-browser-global-in-render-or-hook-init": "error",
        "react-doctor/effect-needs-cleanup": "error",
        "react-doctor/no-effect-with-fresh-deps": "error",
        "react-doctor/aria-role": "error",
        "react-doctor/no-ref-current-in-render": "error",
        "react-doctor/no-impure-state-updater": "error",
        "react-doctor/no-layout-property-animation": "error"
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "kebabCase" }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "No feature imports another feature. Within a feature, imports are relative; ground two features share belongs in `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "The direction is app → features → shared and never back: `app/` composes features, so a feature importing `app/` is a cycle waiting to be written."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared/ imports nothing above it: it is the layer every feature and the app layer stand on, and an import upwards makes it one of them."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/api/trpc.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "allowTypeImports": true,
                "message": "This file is the api's type seam: an `import type` is allowed here and a value import is not, so runtime coupling stays zero."
              },
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared/ imports nothing above it: it is the layer every feature and the app layer stand on, and an import upwards makes it one of them."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/auth/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "No feature imports another feature. Within a feature, imports are relative; ground two features share belongs in `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "The direction is app → features → shared and never back: `app/` composes features, so a feature importing `app/` is a cycle waiting to be written."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/ui/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "react-doctor/effect-needs-cleanup": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/tests/**", "**/e2e/**"],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-conditional-empty-object-spread": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-type-aliases": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-widen-then-assert": "off"
      }
    },
    {
      "files": ["apps/api/src/config.ts", "apps/web/playwright.config.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["packages/core/src/store/git/index.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["scripts/**", "packages/devtools/src/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/tests/**", "**/e2e/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "apps/api/lifts/better-auth-cimd-node/index.ts",
        "apps/api/src/auth/auth.ts",
        "apps/api/src/auth/routes.ts",
        "apps/api/src/auth/verify.ts",
        "apps/api/src/ingress/limits.ts",
        "apps/api/src/mcp/surface.ts",
        "apps/api/src/ops/index.ts",
        "apps/api/tests/backup-image.test.ts",
        "apps/api/tests/coding-rules-form.test.ts",
        "apps/api/tests/deploy-tree.test.ts",
        "apps/api/tests/harness-sources.ts",
        "apps/api/tests/image-probe.ts",
        "apps/api/tests/mcp-surface.test.ts",
        "apps/api/tests/web-client.ts",
        "apps/web/src/app/frame.tsx",
        "apps/web/src/features/auth/choose-workspace-screen.tsx",
        "apps/web/src/features/sources/bindings-view.tsx",
        "apps/web/src/shared/api/upload-progress.ts",
        "packages/core/src/answering/index.ts",
        "packages/core/src/audit/index.ts",
        "packages/core/src/concepts/file.ts",
        "packages/core/src/concepts/index.ts",
        "packages/core/src/concepts/landing.ts",
        "packages/core/src/concepts/loader.ts",
        "packages/core/src/concepts/reconciler.ts",
        "packages/core/src/concepts/visibility.ts",
        "packages/core/src/erasure/map.ts",
        "packages/core/src/erasure/rehearsal.ts",
        "packages/core/src/erasure/routine.ts",
        "packages/core/src/llm/index.ts",
        "packages/core/src/runs/index.ts",
        "packages/core/src/sources/binding.ts",
        "packages/core/src/sources/chunk-address.ts",
        "packages/core/src/sources/dpia.ts",
        "packages/core/src/sources/orphans.ts",
        "packages/core/src/sources/review.ts",
        "packages/core/src/store/git/index.ts",
        "packages/core/src/store/graph/index.ts",
        "packages/core/test/bundle.ts",
        "packages/core/test/erasure-replay.test.ts",
        "packages/core/test/erasure-routine.test.ts",
        "packages/core/test/queue.contract.test.ts",
        "packages/core/test/sources.test.ts",
        "packages/core/test/tier-contract.test.ts",
        "packages/devtools/lint-rules/rules/import-direction.ts",
        "packages/devtools/lint-rules/rules/mcp-entry-no-workspace-argument.ts",
        "packages/devtools/src/land.ts",
        "packages/devtools/src/mutant-probe.ts",
        "packages/devtools/src/throwaway-tree.ts",
        "packages/schema/src/concept-tables.ts",
        "packages/schema/src/journal.ts",
        "packages/schema/test/finding-factory.test.ts",
        "packages/schema/test/null-safe-checks.test.ts",
        "packages/schema/test/readable-chunk.test.ts"
      ],
      "rules": {
        "complexity": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "reports",
    ".venv",
    "packages/devtools/lifts/anti-slop/**",
    ".claude/worktrees/**",
    ".claude/skills/**",
    "**/stryker-setup-*.js"
  ]
}
