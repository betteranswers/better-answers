{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "import",
    "node",
    "promise"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./packages/devtools/lifts/anti-slop/index.ts"
    },
    {
      "name": "better-answers",
      "specifier": "./packages/devtools/lint-rules/index.ts"
    },
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "unicorn/prefer-set-has": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-deprecated": "error",
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "promise/no-callback-in-promise": "error",
    "promise/no-multiple-resolved": "error",
    "typescript/only-throw-error": [
      "error",
      { "allow": [{ "from": "package", "package": "@tanstack/router-core", "name": "Redirect" }] }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-constructed-context-values": "error",
    "complexity": ["error", { "max": 8 }],
    "node/no-process-env": "error",
    "import/no-cycle": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-param-reassign": ["error", { "props": true }],
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "BinaryExpression[operator='in'][right.type='Identifier'][right.name=/^[A-Z][A-Z0-9_]+$/]",
        "message": "`in` also answers for a name the table inherits, such as `toString`. Test the key with `Object.hasOwn(TABLE, key)`, or hold the table in a `Map`"
      },
      {
        "selector": "ForInStatement",
        "message": "`for…in` also walks the keys an object inherits. Walk `Object.keys` or `Object.entries` with `for…of`"
      },
      {
        "selector": "LabeledStatement",
        "message": "A label jumps out of a nested loop. Move the inner loop into a function and return from it"
      },
      {
        "selector": "CallExpression[callee.object.name='z'][callee.property.name='enum'] > :matches(ArrayExpression, TSAsExpression[expression.type='ArrayExpression'], TSSatisfiesExpression[expression.type='ArrayExpression'])",
        "message": "A list written inside `z.enum` copies a closed set, and drifts from it. Declare the set once as an `as const` tuple, derive its type from it, and pass the tuple to `z.enum`"
      },
      {
        "selector": "Literal[regex.flags=/[uv]/][regex.pattern=/^(?:[^\\\\]|\\\\.)*\\\\v/]",
        "message": "Stryker negates `\\v` to `\\V`, which the `u` and `v` flags refuse at load, so the mutation run cannot import this module. Drop the flag and disable `eslint/require-unicode-regexp` on this line with that reason"
      }
    ],
    "vitest/no-identical-title": "error",
    "vitest/no-conditional-in-test": "error",
    "vitest/valid-title": [
      "error",
      {
        "mustNotMatch": [
          "/(?i:\\bshould\\b)|(?:\\S+\\s+){10}\\S/",
          "A test title is a present-tense phrase of 10 words at most, never \"should\""
        ]
      }
    ],
    "typescript/no-floating-promises": ["error", { "ignoreVoid": true }],
    "typescript/no-unnecessary-condition": "error",
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": false }],
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "eslint/require-unicode-regexp": "error",
    "eslint/no-shadow": "error",
    "eslint/no-await-in-loop": "error",
    "eslint/no-warning-comments": ["error", { "decoration": ["*"] }],
    "unicorn/no-abusive-eslint-disable": "error",
    "oxc/no-async-await": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "better-answers/action-admits-before-await": "error",
    "better-answers/comment-only-the-why": "error",
    "better-answers/declaration-doc-block": "error",
    "better-answers/import-statically": "error",
    "better-answers/string-cites-nothing": "error",
    "better-answers/no-path-climb": "error",
    "better-answers/mcp-entry-annotations": "error",
    "better-answers/mcp-entry-no-workspace-argument": "error",
    "better-answers/import-direction": "error",
    "better-answers/parameter-never-mutated": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "max-lines": ["error", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 150, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/boundary-schemas/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/; the rest of the tier takes Claims and a Principal from that module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/boundary-schemas/drizzle-zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/auth/**", "apps/api/lifts/better-auth-cimd-node/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/boundary-schemas/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "jsPlugins": [
        {
          "name": "react-doctor",
          "specifier": "oxlint-plugin-react-doctor"
        }
      ],
      "rules": {
        "react-doctor/rules-of-hooks": "error",
        "react-doctor/no-unguarded-browser-global-in-render-or-hook-init": "error",
        "react-doctor/effect-needs-cleanup": "error",
        "react-doctor/no-effect-with-fresh-deps": "error",
        "react-doctor/aria-role": "error",
        "react-doctor/no-ref-current-in-render": "error",
        "react-doctor/no-impure-state-updater": "error",
        "react-doctor/no-layout-property-animation": "error"
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "kebabCase" }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/boundary-schemas/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "In apps/web, better-auth is imported only by features/auth/auth-client.ts and features/auth/auth-hooks.ts; every other file reads the platform's types those hooks return."
              },
              {
                "group": ["**/auth-client", "**/auth-client.ts"],
                "message": "authClient is imported only by features/auth/auth-hooks.ts, which maps what it answers to the platform's own types."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "No feature imports another feature. Within a feature, imports are relative; ground two features share belongs in `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "The direction is app → features → shared and never back: `app/` composes features, so a feature importing `app/` is a cycle waiting to be written."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/boundary-schemas/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "In apps/web, better-auth is imported only by features/auth/auth-client.ts and features/auth/auth-hooks.ts; every other file reads the platform's types those hooks return."
              },
              {
                "group": ["**/auth-client", "**/auth-client.ts"],
                "message": "authClient is imported only by features/auth/auth-hooks.ts, which maps what it answers to the platform's own types."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared/ imports nothing above it: it is the layer every feature and the app layer stand on, and an import upwards makes it one of them."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…`."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api. The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/boundary-schemas/drizzle-zod.ts; import the boundary schemas from @better-answers/schema."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
