{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "import"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./apps/api/tools/anti-slop/index.ts"
    },
    {
      // The repository's own rules — each holds a CODING_RULES or ADR line and is run
      // by a functional test (apps/api/tests/lint-rules.test.ts).
      "name": "better-answers",
      "specifier": "./apps/api/tools/lint-rules/index.ts"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    // ADR 0029 rule 4 — the slice graph is acyclic. Repo-wide because a cycle is a
    // design failure anywhere, and oxlint 1.80 has no `import/no-restricted-paths`
    // to express the direction rules more precisely.
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "oxc/no-async-await": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/require-safety-comment-for-type-assertion": "warn",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    // T-004 (ADR 0018, [SEC2]): every MCP entry carries its annotations, and none takes
    // a workspace, bundle or tenant argument.
    "better-answers/mcp-entry-annotations": "error",
    "better-answers/mcp-entry-no-workspace-argument": "error"
  },
  "overrides": [
    {
      // ADR 0028 — drizzle-zod is imported through one module, so the drizzle-orm v1
      // move to `drizzle-orm/zod` is one edit. Everything else imports the boundary
      // schemas from @better-answers/schema. First in this list on purpose: a later
      // override that sets `no-restricted-imports` (packages/core's transport ban)
      // replaces this config for its files, so that override carries the drizzle-zod
      // pattern too.
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema."
              },
              {
                // The identity provider stays behind its seam (ADR 0009): no better-auth
                // import outside apps/api/src/auth/ and the CIMD lift (the override below
                // lifts the ban for exactly those two directories).
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/ (ADR 0009); the rest of the tier takes Claims and a Principal from that module."
              }
            ]
          }
        ]
      }
    },
    {
      // The one seam file the drizzle-zod ban exists to protect.
      "files": ["packages/schema/src/drizzle-zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // The identity module and the CIMD lift: the only places better-auth is configured
      // (ADR 0009). The drizzle-zod ban is restated because this override replaces the
      // repo-wide no-restricted-imports config for these files.
      "files": ["apps/api/src/auth/**", "apps/api/lifts/better-auth-cimd-node/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema."
              }
            ]
          }
        ]
      }
    },
    {
      // ADR 0029 rule 5 — nothing in `packages/core` imports a transport or a transport's
      // dependency. `core` is a library with five callers, four of which have no notion of an
      // HTTP status code; a transport import here is how that boundary erodes. A package
      // boundary cannot enforce this on its own, which is why it is a lint rule.
      // Verified against oxlint 1.80.0: a per-glob override fires inside its glob and stays
      // silent outside it.
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "hono",
                  "hono/*",
                  "@hono/*",
                  "@trpc/*",
                  "@modelcontextprotocol/*",
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*",
                  "node:http",
                  "node:http2",
                  "node:https"
                ],
                "message": "packages/core is transport-agnostic (ADR 0029 rule 5). A status code, a Request or a Response belongs in apps/api; export a function and a typed error instead."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema. Restated here because this override replaces the repo-wide no-restricted-imports config for packages/core."
              }
            ]
          }
        ]
      }
    },
    {
      // React correctness rules run over `apps/web/` alone: this is the one root config for
      // the API (`apps/api/`), the SPA (`apps/web/`) and the shared packages, and a react-doctor
      // finding on server code would be noise. oxlint 1.80 scopes `jsPlugins` per override,
      // so the plugin itself is loaded here rather than beside `anti-slop` at the top level.
      "files": ["apps/web/**"],
      "jsPlugins": [
        {
          "name": "react-doctor",
          "specifier": "oxlint-plugin-react-doctor"
        }
      ],
      "rules": {
        "react-doctor/rules-of-hooks": "error",
        "react-doctor/no-unguarded-browser-global-in-render-or-hook-init": "error",
        "react-doctor/effect-needs-cleanup": "error",
        "react-doctor/no-effect-with-fresh-deps": "error",
        "react-doctor/aria-role": "error",
        "react-doctor/no-ref-current-in-render": "error",
        "react-doctor/no-impure-state-updater": "error",
        "react-doctor/no-layout-property-animation": "error"
      }
    },
    {
      // T-036 — the SPA's rules. Two things every file in `apps/web` obeys, before the zones
      // below narrow them further.
      //
      // Filenames are kebab-case, so a component's file reads the same on a case-insensitive
      // and a case-sensitive filesystem and a rename is never a no-op commit.
      //
      // `no-restricted-imports` carries the SPA's import shape. oxlint 1.80 has no
      // `import/no-restricted-paths`, so a layering zone cannot be expressed as "this directory
      // may not reach that one"; it is expressed instead as a convention a glob *can* read — a
      // relative import stays inside its own directory, and anything that crosses one is written
      // `@/<zone>/…` (the path alias in `apps/web/tsconfig.json` and `vite.config.ts`). The
      // overrides after this one then name zones rather than counting `../`.
      //
      // Testing-library and jest-dom rules: not enabled, because oxlint 1.80 ships neither
      // plugin (checked against `node_modules/oxlint/configuration_schema.json`, 03/09/2026);
      // the component suites are held by review and by `[TEST1]` instead.
      "files": ["apps/web/**"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "kebabCase" }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…` (T-036), because that is what the layering overrides in this file can read."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api (ADR 0006). The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema. Restated here because this override replaces the repo-wide no-restricted-imports config for apps/web."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/ (ADR 0009). Restated here because this override replaces the repo-wide no-restricted-imports config for apps/web."
              }
            ]
          }
        ]
      }
    },
    {
      // A feature owns one concern of the product and the requests it issues (ADR 0006's
      // amendment; the bulletproof-react api-layer pattern). It reaches down to `shared/` and
      // never sideways or up: a feature that needs another feature's ground is two features
      // sharing something that belongs in `shared/`, and a feature that reaches into `app/`
      // has inverted the direction the app composes in.
      "files": ["apps/web/src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "No feature imports another feature (T-036). Within a feature, imports are relative; ground two features share belongs in `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "The direction is app → features → shared and never back (T-036): `app/` composes features, so a feature importing `app/` is a cycle waiting to be written."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…` (T-036), because that is what the layering overrides in this file can read."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api (ADR 0006). The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema. Restated here because this override replaces the config above."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/ (ADR 0009). Restated here because this override replaces the config above."
              }
            ]
          }
        ]
      }
    },
    {
      // `shared/` is the bottom of the SPA: the tRPC client, the design-system bridge, the
      // registry primitives and the screen list. It imports nothing above it, which is what
      // makes it safe for every feature and the app layer to import.
      "files": ["apps/web/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared/ imports nothing above it (T-036): it is the layer every feature and the app layer stand on, and an import upwards makes it one of them."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…` (T-036), because that is what the layering overrides in this file can read."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api (ADR 0006). The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema. Restated here because this override replaces the config above."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/ (ADR 0009). Restated here because this override replaces the config above."
              }
            ]
          }
        ]
      }
    },
    {
      // ADR 0006's one exception, as one line of configuration: this file, `AppRouter`, and
      // `import type`. Everything else the shared override bans stays banned, so a value import
      // of `AppRouter` fails here and an `import type` of it fails in every other file.
      "files": ["apps/web/src/shared/api/trpc.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "allowTypeImports": true,
                "message": "This file is the api's type seam: an `import type` is allowed here and a value import is not (ADR 0006, amended 2026-09-02), so runtime coupling stays zero. The guarantee is `import type`-only rather than `AppRouter`-only — oxlint 1.80 ignores `allowImportNames` beside `allowTypeImports`, and `import type`-only is what the amendment asks for."
              },
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared/ imports nothing above it (T-036): it is the layer every feature and the app layer stand on, and an import upwards makes it one of them."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…` (T-036), because that is what the layering overrides in this file can read."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema. Restated here because this override replaces the config above."
              },
              {
                "group": [
                  "better-auth",
                  "better-auth/*",
                  "better-auth/*/*",
                  "@better-auth/*",
                  "@better-auth/*/*"
                ],
                "message": "better-auth is imported only under apps/api/src/auth/ and apps/api/lifts/better-auth-cimd-node/ (ADR 0009). Restated here because this override replaces the config above."
              }
            ]
          }
        ]
      }
    },
    {
      // T-037 — the SPA's identity feature is the one directory in `apps/web` that may name
      // `better-auth`, which is the same shape `apps/api/src/auth/` has on the other side
      // (ADR 0009): one directory owns the library, and everything above it
      // speaks screens, workspaces and roles rather than endpoints. The product signs a
      // person in by posting to Better Auth, so *somewhere* has to know its client; what
      // the rule buys is that the somewhere is one directory a reviewer can read in a
      // sitting. So it is exactly one glob with no carve-out: since T-046 the module's own
      // hooks stand on this client, `@better-auth-ui/*` is uninstalled, and a package that
      // is not in the lockfile needs no ban glob — its absence is the fence.
      //
      // Everything the zone overrides above ban stays banned here — no feature reaches
      // another, none reaches `app/`, none imports the api at runtime.
      "files": ["apps/web/src/features/auth/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "No feature imports another feature (T-036). Within a feature, imports are relative; ground two features share belongs in `apps/web/src/shared/`."
              },
              {
                "group": ["@/app/**"],
                "message": "The direction is app → features → shared and never back (T-036): `app/` composes features, so a feature importing `app/` is a cycle waiting to be written."
              },
              {
                "group": ["../*/**", "../../**"],
                "message": "A relative import in apps/web stays inside its own directory; an import that crosses one is written `@/<zone>/…` (T-036), because that is what the layering overrides in this file can read."
              },
              {
                "group": ["@better-answers/api", "@better-answers/api/*"],
                "message": "apps/web imports nothing from apps/api (ADR 0006). The one exception is `AppRouter` as an `import type`, in `apps/web/src/shared/api/trpc.ts` and no second file; runtime coupling stays zero."
              },
              {
                "group": ["drizzle-zod"],
                "message": "drizzle-zod is imported only by packages/schema/src/drizzle-zod.ts (ADR 0028); import the boundary schemas from @better-answers/schema. Restated here because this override replaces the config above."
              }
            ]
          }
        ]
      }
    },
    {
      // Registry source (ADR 0033): shadcn's primitives, Kibo UI's composed pieces and
      // Vercel AI Elements, installed here as source. The rule the ADR states is that they
      // own behaviour — keyboard handling, focus, ARIA wiring, subscriptions — and the
      // platform owns meaning. These four rules judge how a component is written, which is
      // the part that is theirs; leaving them on would mean rewriting an upstream carousel's
      // effects on every registry update and calling the result reviewed.
      //
      // What is *not* relaxed: every import rule above, `no-console`, the anti-slop rules
      // that catch a widened type, and `[A11Y1]` itself — a screen carries the WCAG 2.2 AA
      // line and is tested with a keyboard and a screen reader whatever a primitive does.
      // Meaning stays ours: a trust word, a citation unit or a register decision never comes
      // out of this directory.
      "files": ["apps/web/src/shared/ui/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "react-doctor/effect-needs-cleanup": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-conditional-empty-object-spread": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-type-aliases": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-widen-then-assert": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "reports",
    ".venv",
    "apps/api/tools/anti-slop/**",
    ".claude/worktrees/**",
    "**/stryker-setup-*.js"
  ]
}
