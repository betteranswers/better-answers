{
  "noun": "screen, surface and secondary nav",
  "readerWord": "page, area and menu",
  "sweep": "U7. Pages, areas and the menu",
  "collisions": [
    {
      "with": "Playwright's `page`, the browser tab a spec drives",
      "codeWord": "page"
    },
    {
      "with": "the row menu and the registry's dropdown menu",
      "codeWord": "menu"
    }
  ],
  "words": [
    { "from": "secondary nav", "to": "menu" },
    { "from": "screen", "to": "page" },
    { "from": "screens", "to": "pages" },
    { "from": "surface", "to": "area" },
    { "from": "surfaces", "to": "areas" }
  ],
  "symbols": {
    "paths": [
      "apps/web/src/**",
      "apps/web/test/**",
      "apps/web/e2e/**",
      "apps/web/journeys/**",
      "apps/api/src/**",
      "apps/api/tests/**",
      "packages/core/src/**",
      "packages/core/test/**",
      "packages/schema/src/**",
      "packages/devtools/src/**",
      "packages/devtools/test/**"
    ]
  },
  "text": {
    "paths": [
      "apps/web/src/**",
      "apps/web/test/**",
      "apps/web/e2e/**",
      "apps/web/journeys/**",
      "apps/api/src/**",
      "apps/api/tests/**",
      "packages/core/src/**",
      "packages/core/test/**",
      "packages/schema/src/**",
      "packages/devtools/src/**",
      "packages/devtools/test/**"
    ]
  },
  "senses": [
    { "sense": "Testing Library's screen", "paths": ["apps/web/test/**"], "matches": ["^screen$"] },
    { "sense": "a screen reader", "matches": ["[Ss]creen[- ]?[Rr]eaders?"] },
    {
      "sense": "Tailwind's screen sizes",
      "matches": ["(?:^|[\\s\"'`:])(?:min-|max-)?[hw]-screen"]
    },
    { "sense": "the design system's surface tokens", "matches": ["--surface-"] },
    { "sense": "the MCP surface", "matches": ["(?:MCP|Mcp|mcp)[-_ ]?[Ss]urface"] },
    {
      "sense": "the roles' surface, roles-surface.json",
      "matches": ["[Rr]oles(?:'|-|_)?\\s?[Ss]urface"]
    },
    {
      "sense": "the roles' surface, as the schema names it",
      "paths": ["packages/schema/**"],
      "matches": ["[Ss]urface"]
    },
    {
      "sense": "what the api exposes to a caller, of which the MCP surface is one: a hostname's, a token's, a library's or the database's grants",
      "paths": ["apps/api/**"],
      "matches": ["[Ss]urface|SURFACE"]
    },
    {
      "sense": "the words test, its list and its baseline, which spell the words they refuse",
      "paths": [
        "apps/api/tests/avoid-words.test.ts",
        "apps/api/tests/words-scan.ts",
        "apps/api/tests/old-words-ratchet.json"
      ]
    }
  ]
}
