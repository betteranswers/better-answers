{
  // oxlint switches a plugin rule on from a rules block and from nowhere on the command
  // line, so this gate runs under a config of its own until it is adopted.
  "jsPlugins": [
    {
      "name": "better-answers",
      "specifier": "./index.ts"
    }
  ],
  "rules": {
    "better-answers/comment-only-the-why": "error"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "reports",
    ".venv",
    // Edited upstream and never here, which is why the root config walks past it too.
    "packages/devtools/lifts/anti-slop/**",
    ".claude/worktrees/**"
  ]
}
