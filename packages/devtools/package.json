{
  "name": "@better-answers/devtools",
  "version": "0.1.0",
  "private": true,
  "description": "The repository's own gate tooling — the throwaway-tree runner and the two oxlint plugins. Imported by suites and by the lint config; never deployed (ADR 0029).",
  "type": "module",
  "exports": {
    "./throwaway-tree": "./src/throwaway-tree.ts"
  },
  "scripts": {
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node ../../scripts/check.mjs lint typecheck test"
  },
  "devDependencies": {
    "@better-answers/devtools": "workspace:*",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
