{
  "name": "@better-answers/devtools",
  "version": "0.1.0",
  "private": true,
  "description": "The repository's own gate tooling — the throwaway-tree runner and the two oxlint plugins. Imported by suites and by the lint config; never deployed (ADR 0029).",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./comment-density": "./src/comment-density.ts",
    "./insert-scan": "./src/insert-scan.ts",
    "./jscpd": "./src/jscpd.ts",
    "./mutant-probe": "./src/mutant-probe.ts",
    "./mutation-shards": "./src/mutation-shards.ts",
    "./mutation-summary": "./src/mutation-summary.ts",
    "./oxlint-config": "./src/oxlint-config.ts",
    "./paths": "./src/paths.ts",
    "./rename": "./src/rename/index.ts",
    "./root-commands": "./src/root-commands.ts",
    "./throwaway-tree": "./src/throwaway-tree.ts",
    "./workflows": "./src/workflows.ts",
    "./worktree-hooks": "./src/worktree-hooks.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/check.mjs lint:ts lint:python lint:python-format",
    "lint:ts": "oxlint --report-unused-disable-directives-severity=error --config ../../.oxlintrc.json .",
    "lint:python": "cd ../../apps/worker && uv run --frozen ruff check ../../packages/devtools/python",
    "lint:python-format": "cd ../../apps/worker && uv run --frozen ruff format --check ../../packages/devtools/python",
    "rename": "node src/rename/replay.ts",
    "typecheck": "node ../../scripts/check.mjs typecheck:ts typecheck:python",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:python": "cd ../../apps/worker && uv run --frozen mypy --strict ../../packages/devtools/python",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "check": "node ../../scripts/check.mjs lint:python lint:python-format typecheck test"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@better-answers/devtools": "workspace:*",
    "@better-answers/schema": "workspace:*",
    "@oxlint/plugins": "1.85.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.6",
    "cloc": "2.6.0-cloc",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "testcontainers": "12.1.0",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
