{
  "name": "@better-answers/devtools",
  "version": "0.1.0",
  "private": true,
  "description": "The repository's own gate tooling — the throwaway-tree runner and the two oxlint plugins. Imported by suites and by the lint config; never deployed (ADR 0029).",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./auth-seam-scan": "./src/scans/auth-seam-scan.ts",
    "./comment-density": "./src/comments/comment-density.ts",
    "./comment-inventory": "./src/comments/comment-inventory.ts",
    "./contract-paths": "./src/scans/contract-paths.ts",
    "./face-admission": "./src/scans/face-admission.ts",
    "./import-direction": "./lint-rules/rules/import-direction.ts",
    "./insert-scan": "./src/scans/insert-scan.ts",
    "./jscpd": "./src/scans/jscpd.ts",
    "./line-references": "./src/scans/line-references.ts",
    "./loose-files": "./src/scans/loose-files.ts",
    "./move-files": "./src/moves/move-files.ts",
    "./mutant-probe": "./src/mutation/mutant-probe.ts",
    "./mutation-shards": "./src/mutation/mutation-shards.ts",
    "./mutation-summary": "./src/mutation/mutation-summary.ts",
    "./oxlint-config": "./src/root-config/oxlint-config.ts",
    "./parsed-source": "./src/parsed-source.ts",
    "./paths": "./src/paths.ts",
    "./refusal-unions": "./src/scans/refusal-unions.ts",
    "./root-commands": "./src/root-config/root-commands.ts",
    "./table-ownership-scan": "./src/scans/table-ownership-scan.ts",
    "./test-folders": "./src/scans/test-folders.ts",
    "./throwaway-tree": "./src/throwaway-tree.ts",
    "./workflows": "./src/root-config/workflows.ts",
    "./worktree-hooks": "./src/worktree-hooks.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/check.mjs lint:ts lint:python lint:python-format",
    "lint:ts": "oxlint --report-unused-disable-directives-severity=error --config ../../.oxlintrc.json .",
    "lint:python": "cd ../../apps/worker && uv run --frozen ruff check ../../packages/devtools/python",
    "lint:python-format": "cd ../../apps/worker && uv run --frozen ruff format --check ../../packages/devtools/python",
    "typecheck": "node ../../scripts/check.mjs typecheck:ts typecheck:python",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:python": "cd ../../apps/worker && uv run --frozen mypy --strict ../../packages/devtools/python",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "check": "node ../../scripts/check.mjs lint:python lint:python-format typecheck test"
  },
  "devDependencies": {
    "@better-answers/devtools": "workspace:*",
    "@better-answers/schema": "workspace:*",
    "@oxlint/plugins": "1.89.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.6",
    "cloc": "2.6.0-cloc",
    "jscpd": "5.4.1",
    "knip": "6.42.1",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
