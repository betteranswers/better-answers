{
  "name": "@better-answers/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ulid": "./src/ulid.ts",
    "./concept-file": "./src/knowledge/concept-file.ts",
    "./scan": "./src/knowledge/scan.ts",
    "./table-ownership": "./src/table-ownership.ts",
    "./code-unit": "./src/code-unit.ts",
    "./email-code": "./src/people/email-code.ts",
    "./email-address": "./src/people/email-address.ts",
    "./second-factor": "./src/people/second-factor.ts",
    "./theme": "./src/platform/theme.ts",
    "./tab-workspace": "./src/platform/tab-workspace.ts",
    "./upload-headers": "./src/sources/upload-headers.ts",
    "./testing": "./test/support/testing.ts",
    "./testing/apple-git": "./test/support/apple-git.ts",
    "./testing/authenticator-code": "./test/people/authenticator-code.ts",
    "./testing/matching": "./test/support/matching.ts",
    "./testing/probes": "./test/support/probes.ts",
    "./testing/test-title": "./test/support/test-title.ts",
    "./testing/test-title-setup": "./test/support/test-title-setup.ts",
    "./testing/warm-postgres": "./test/support/warm-postgres.ts"
  },
  "scripts": {
    "generate": "node scripts/generate-migrations.ts",
    "generate:worker-view": "node scripts/generate-worker-schema.ts",
    "generate:roles-surface": "node scripts/generate-roles-surface.ts",
    "generate:contract-stamp": "node scripts/generate-contract-stamp.ts",
    "lint": "oxlint --report-unused-disable-directives-severity=error --config ../../.oxlintrc.json .",
    "typecheck": "tsc --noEmit",
    "check": "node ../../scripts/check.mjs typecheck test",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
